<%-- הגדרת דף אב (Master Page) בשפת C#, קישור לקובץ הקוד שלו והגדרת מחלקת הירושה --%>
<%@ Master Language="C#" AutoEventWireup="true" CodeFile="MasterPage.master.cs" Inherits="MasterPage" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <%-- כותרת הדף שתופיע בלשונית של הדפדפן --%>
    <title>MOOVIES</title>
    
    <%-- אזור דינמי שמאפשר לדפים הבנים להכניס אלמנטים משלהם לתוך ה-head (כמו עיצוב ייחודי או סקריפטים) --%>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>

    <%-- תגיות עיצוב (CSS) פשוט וחלקה שמחליפה את הטבלאות הישנות --%>
    <style>
        /* עיצוב כללי לגוף העמוד: גופן מודרני, יישור למרכז ורקע אפור בהיר ונעים */
        body {
            font-family: Arial, sans-serif;
            text-align: center;
            background-color: #f4f7f6;
            margin: 0;
            padding: 20px;
            color: #333;
        }

        /* עיצוב כותרת האתר הראשית */
        h1 {
            color: #2c3e50;
            margin-bottom: 20px;
        }

        /* עיצוב תפריט הניווט (הקישורים) - הופך אותם לשורה חלקה של כפתורים */
        nav {
            margin-bottom: 30px;
            padding: 10px;
            background-color: #ffffff;
            border-radius: 8px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.05);
            display: inline-block;
        }

        /* עיצוב הקישורים עצמם בתוך תפריט הניווט */
        nav a {
            text-decoration: none;
            color: #3498db;
            padding: 10px 15px;
            margin: 0 5px;
            font-weight: bold;
            transition: 0.3s; /* אפקט מעבר חלק בשינוי צבע */
        }

        /* שינוי צבע הקישור כאשר המשתמש מרחף מעליו עם העכבר */
        nav a:hover {
            color: #2980b9;
            background-color: #e8f4f8;
            border-radius: 5px;
        }

        /* עיצוב תיבת התוכן המרכזית שבה יוצגו הדפים השונים */
        .main-content {
            max-width: 800px;
            margin: 0 auto;
            background-color: #ffffff;
            padding: 30px;
            border-radius: 8px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }

        /* עיצוב הודעת הברוך הבא למשתמש המחובר */
        .welcome-msg {
            font-size: 18px;
            font-weight: bold;
            color: #27ae60;
            margin-bottom: 15px;
        }
    </style>
</head>
<body>
    <%-- בדיקה: אם קיים משתמש מחובר (מנהל או משתמש רגיל), נציג לו הודעת שלום --%>
    <% if (Session["nihul"] == "ok" || Session["user"] == "ok") { %>
        <%-- הצגת הודעת שלום ושם המשתמש מתוך משתנה הסשן (Session) --%>
        <div class="welcome-msg">שלום <%=Session["name"] %></div>
    <% } // סיום תנאי הבדיקה %>

    <%-- כותרת האתר הראשית --%>
    <h1>MOVIES</h1>

   <%-- תפריט הניווט של האתר (מעודכן עם דף האודות) --%>
    <nav>
        <%-- בדיקה: אם המשתמש מחובר (כמנהל או כמשתמש רגיל) - נציג לו את דף הטופס --%>
        <% if (Session["nihul"] == "ok" || Session["user"] == "ok") { %>
            <a href="form.aspx">form</a>
        <% } // סיום בדיקת משתמש מחובר לטופס %>

        <%-- קישורים שפתוחים תמיד לכולם --%>
        <a href="about.aspx">about</a>
        <a href="developer.aspx">developer</a>
        <a href="gallery.aspx">gallery</a>

        <%-- בדיקה: אם המשתמש מוגדר כאורח (לא מנהל מחובר ולא משתמש מחובר) --%>
        <% if (Session["nihul"] != "ok" && Session["user"] != "ok") { %>
            <%-- נציג לו אפשרות להירשם או להתחבר לאתר --%>
            <a href="register.aspx">register</a>
            <a href="login.aspx">login</a>
        <% } // סיום בדיקת אורח %>

        <%-- בדיקה: אם המשתמש מחובר ספציפית כמנהל (nihul) --%>
        <% if (Session["nihul"] == "ok") { %>
            <%-- נציג לו את דף הניהול הראשי --%>
            <a href="administration.aspx">administration</a>
        <% } // סיום בדיקת מנהל %>

        <%-- בדיקה: אם המשתמש מחובר (מנהל או רגיל), נציג לו כפתור התנתקות/יציאה --%>
        <% if (Session["nihul"] == "ok" || Session["user"] == "ok") { %>
            <a href="exit.aspx">exit</a>
        <% } // סיום בדיקת כפתור יציאה %>
    </nav>
    <%-- תיבת התוכן המרכזית (מחליפה את השורה השנייה בטבלה הישנה) --%>
    <div class="main-content">
        <%-- אזור דינמי ראשי: כאן יוצג התוכן הייחודי של כל דף בן שיורש מדף האב הזה --%>
        <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
        </asp:ContentPlaceHolder>
    </div>
</body>
</html>